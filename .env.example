# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=algorithem

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (comma-separated list of allowed origins or * for all)
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,https://rubik-blind-helper.vercel.app
